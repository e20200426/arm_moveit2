<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm_moveit_config">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import arm_moveit_config urdf file -->
    <xacro:include filename="$(find arm_moveit_config)/urdf/arm_moveit_config.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="arm_moveit_config.ros2_control.xacro" />


    <xacro:arm_moveit_config_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
